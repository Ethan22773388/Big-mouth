# 复制为 .env 后填写。真实接入时由后端读取，禁止放到 index.html 或 app.js。

# ─── 行情数据源 ───
DATA_PROVIDER=demo
# 改成 akshare 可启用 AKShare A 股实时数据（需 pip install akshare）
TUSHARE_TOKEN=

# ─── 数据库 ───
# 不设置 DATABASE_URL 时，默认使用本地 SQLite（零配置，文件 backend/app.db）。
# 云端部署时设置为 PostgreSQL 连接串，系统自动切换：
# DATABASE_URL=postgresql://用户名:密码@主机:5432/数据库名
DATABASE_URL=

# 如 SQLite 文件需放在云盘等网络文件系统，请指向本地磁盘路径，避免文件锁：
# SQLITE_PATH=/tmp/quant_app.db
SQLITE_PATH=

# ─── 服务监听 ───
HOST=127.0.0.1
PORT=8787
